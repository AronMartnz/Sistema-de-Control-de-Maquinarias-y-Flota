{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistema-de-control-de-maquinarias-y-flota",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corssen_db",
      "database_id": "12f31b4b-539a-41b0-ade0-3a41fa5878f5",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CORSSEN_STORAGE",
      "id": "eb3b9ca897104bc19057e403166cb65f"
    }
  ]
}

