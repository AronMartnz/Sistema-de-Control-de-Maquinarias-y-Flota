<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
  <defs>
    <!-- Gradiente azul vibrante e industrial -->
    <linearGradient id="corssenBlue" x1="10%" y1="0%" x2="90%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6" />
      <stop offset="50%" stop-color="#2563eb" />
      <stop offset="100%" stop-color="#1d4ed8" />
    </linearGradient>

    <!-- Gradiente gris oscuro / grafito mate -->
    <linearGradient id="corssenDark" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#475569" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>

    <!-- Sombra suave para elevación premium -->
    <filter id="softElevation" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#0f172a" flood-opacity="0.08" />
    </filter>
  </defs>

  <!-- Contenedor Circular Blanco Impecable -->
  <circle cx="100" cy="100" r="94" fill="#ffffff" stroke="#f1f5f9" stroke-width="4" filter="url(#softElevation)" />
  
  <!-- Anillo exterior decorativo muy sutil -->
  <circle cx="100" cy="100" r="92" fill="none" stroke="#e2e8f0" stroke-width="1.5" stroke-dasharray="2 6" opacity="0.6"/>

  <g transform="translate(18, 16)">
    <!-- Letra C dinámica exterior con extremos en corte biselado exacto -->
    <!-- Arco azul que envuelve a la L -->
    <path d="M 124 38
             A 62 62 0 1 0 124 130
             L 106 112
             A 38 38 0 1 1 106 56
             Z"
          fill="url(#corssenBlue)" />

    <!-- Letra L interior estilizada y sólida -->
    <path d="M 52 24
             L 74 24
             L 74 116
             Q 74 126 84 126
             L 138 126
             L 138 144
             L 76 144
             Q 52 144 52 120
             Z"
          fill="url(#corssenDark)" />
  </g>
</svg>
